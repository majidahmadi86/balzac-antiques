# Copy to .env on the server (NEVER commit .env). Password = the one set for
# the "zac" database user in CloudPanel > Databases.
DATABASE_URL="mysql://zac:CHANGE_ME@127.0.0.1:3306/balzac"

SESSION_SECRET=generate-with-openssl-rand-hex-32

# --- Stripe (payment gate) ------------------------------------------------
# Leave these OUT entirely and the site keeps its reserve-and-invoice
# checkout. Fill them in and the buyer is taken to Stripe to pay by card.
# Test keys start sk_test_, live keys start sk_live_.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Signing secret of the webhook endpoint (Stripe > Developers > Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Absolute site origin, used to build the Stripe return URLs.
SITE_URL=https://balzacantiques.ch
